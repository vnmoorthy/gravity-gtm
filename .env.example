# ===== Gravity GTM — environment (copy to .env). Anything left blank runs in safe DEMO mode =====

# 1) CRITICAL — powers ICP engine, discovery (web search w/ citations), outreach, all agents
ANTHROPIC_API_KEY=

# 2) Flexprice (+20 bonus) — usage metering + credit gating. https://app.flexprice.io → Developers → API Keys
FLEXPRICE_API_KEY=
FLEXPRICE_BASE_URL=https://us.api.flexprice.io/v1

# 3) Discovery (optional, improves live search). https://app.tavily.com
TAVILY_API_KEY=

# 4) Enrichment (optional; MX/DNS validation works without it). https://hunter.io/api-keys
HUNTER_API_KEY=

# 5) Email dispatch after HITL approval (optional). https://resend.com/api-keys  (or SendGrid)
RESEND_API_KEY=
SENDGRID_API_KEY=
FROM_EMAIL=

# 6) Graph DB (optional; built-in graph engine is used if blank). Neo4j AuraDB free: https://console.neo4j.io
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# 7) Band (+20 bonus) — app.band.ai → Agents → "Connect remote agent" → copy API Key (band_a_...). Chat ID optional (auto-created)
BAND_API_KEY=
BAND_CHAT_ID=

# 8) Nexla (sponsor) — webhook source URL to stream enriched leads into Nexla
NEXLA_WEBHOOK_URL=

# Safety: sandbox redirects every approved email to TEST_INBOX. Set DISPATCH_MODE=live only for real campaigns.
DISPATCH_MODE=sandbox
TEST_INBOX=
GRAVITY_MODEL=claude-opus-5-5
STARTING_CREDITS=400
